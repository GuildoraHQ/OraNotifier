{
    "schemaVersion": 1,
    "id": "oranotifier",
    "version": "${version}",
    "name": "OraNotifier",
    "description": "Delivers Mcora (mcora.net) votes to this server. No open port needed.",
    "authors": ["Mcora"],
    "contact": { "homepage": "https://mcora.net/docs/minecraft/votifier" },
    "license": "MIT",
    "environment": "server",
    "entrypoints": { "server": ["net.mcora.oranotifier.fabric.OraFabric"] },
    "depends": { "fabricloader": ">=0.16", "fabric-api": "*", "minecraft": "${minecraft_version}" }
}
